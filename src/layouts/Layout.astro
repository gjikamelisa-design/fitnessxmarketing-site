---
interface Props {
  title: string;
  description?: string;
  titleTemplate?: boolean;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Marketing, sales, and business-growth resources for personal trainers and fitness businesses.',
  titleTemplate = true,
  canonical,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const documentTitle = titleTemplate ? `${title} | Fitness x Marketing` : title;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();
const imageUrl = image ? new URL(image, Astro.site).toString() : undefined;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta property="og:site_name" content="Fitness x Marketing" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="https://fitnessxmarketing.com/">FITNESS <span>×</span> MARKETING</a>
      <nav aria-label="Main navigation">
        <a href="https://fitnessxmarketing.com/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
        <a href="https://fitnessxmarketing.com/tools" aria-current={currentPath.startsWith('/tools') ? 'page' : undefined}>Tools</a>
        <a href="https://fitnessxmarketing.com/posts" aria-current={currentPath.startsWith('/posts') || currentPath.startsWith('/blog') ? 'page' : undefined}>Articles</a>
      </nav>
      <p class="resource-hub"><span aria-hidden="true"></span> Resource Hub</p>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Fitness x Marketing</p>
    </footer>

    <style is:global>
      :root {
        --dark: #252a34;
        --slate: #3a4252;
        --teal: #08d9d6;
        --deep-teal: #06a8a5;
        --cyan: #1df7f4;
        --gray: #eaeaea;
        --mint: #eaf6f6;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--dark);
        background: #ffffff;
        line-height: 1.6;
      }

      a {
        color: var(--deep-teal);
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-height: 76px;
        padding: 1rem clamp(1.25rem, 4vw, 3.25rem);
        background: #ffffff;
        border-bottom: 1px solid #e2e5e8;
      }

      .brand {
        color: var(--dark);
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: -0.025em;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
      }

      .brand span {
        color: var(--dark);
      }

      .site-header nav {
        display: flex;
        align-items: center;
        gap: clamp(1.4rem, 3vw, 3rem);
      }

      .site-header nav a {
        color: #818896;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .site-header nav a:hover {
        color: var(--dark);
      }

      .site-header nav a[aria-current='page'] {
        color: var(--dark);
      }

      .resource-hub {
        align-items: center;
        color: #3a4252;
        display: flex;
        font-size: 0.7rem;
        font-weight: 800;
        gap: 0.7rem;
        letter-spacing: 0.2em;
        margin: 0;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .resource-hub span {
        background: var(--teal);
        border-radius: 50%;
        height: 0.55rem;
        width: 0.55rem;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 1.5rem 5rem;
      }

      .site-footer {
        text-align: center;
        padding: 2rem;
        color: var(--slate);
        font-size: 0.9rem;
        border-top: 1px solid var(--gray);
      }

      @media (max-width: 640px) {
        .site-header {
          align-items: center;
          gap: 1.25rem;
          flex-wrap: wrap;
          min-height: 68px;
        }

        .site-header nav {
          border-top: 1px solid #eef0f2;
          justify-content: space-between;
          gap: 0.85rem;
          padding-top: 0.8rem;
          width: 100%;
        }

        .site-header nav a {
          font-size: 0.64rem;
          letter-spacing: 0.08em;
        }

        .resource-hub {
          display: none;
        }

        main {
          padding: 2rem 1.15rem 4rem;
        }
      }
    </style>
  </body>
</html>
