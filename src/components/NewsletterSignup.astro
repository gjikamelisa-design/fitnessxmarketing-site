---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<div class:list={['kit-signup', { dark }]} data-kit-form-id="9841910">
  <script
    is:inline
    async
    data-uid="fd4c730b04"
    src="https://fitnessmarketing.kit.com/fd4c730b04/index.js"
  ></script>
  <noscript>
    <p>Please enable JavaScript to join the Fitness × Marketing newsletter.</p>
  </noscript>
</div>

<style>
  .kit-signup {
    max-width: 660px;
    min-height: 80px;
  }

  .kit-signup :global(.formkit-form) {
    margin-left: 0 !important;
    margin-right: 0 !important;
    max-width: 660px !important;
  }

  noscript p {
    color: #596371;
    margin: 0;
  }

  .dark noscript p { color: #dbe2e5; }
</style>
