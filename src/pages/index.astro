---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    href: '/posts/yelp-chatgpt-personal-trainers',
    title: 'Yelp Reviews Are Coming to ChatGPT. Should Personal Trainers Care?',
    description: 'What the Yelp and ChatGPT connection means for local trainers, and the practical actions worth taking.',
    category: 'AI Visibility',
    image: '/posts/yelp-chatgpt-personal-trainers/images/yelp-chatgpt-personal-trainers.jpg',
    imageAlt: 'YELP ChatGPT personal trainers',
  },
  {
    href: '/posts/ai-for-personal-trainers-top-uses-cases-tasks',
    title: "Where Does AI Actually Fit in a Personal Trainer's Business?",
    description: 'A task-by-task breakdown of where AI saves time and where a human check still matters.',
    category: 'AI for Trainers',
    image: '/posts/ai-for-personal-trainers-top-uses-cases-tasks/images/ai-use-cases-for-personal-trainers.png',
    imageAlt: "Where Does AI Actually Fit in a Personal Trainer's Business, A task-by-task breakdown",
  },
  {
    href: '/posts/do-personal-trainers-need-to-look-the-part-coaches-weigh-in',
    title: 'Do Personal Trainers Need to Look the Part?',
    description: 'Coaches weigh in on body image, credibility and what actually keeps clients.',
    category: 'Fitness Marketing',
    image: '/posts/do-personal-trainers-need-to-look-the-part-coaches-weigh-in/images/linkedin-poll-personal-trainer-physique.png',
    imageAlt: 'LinkedIn poll asking personal trainers whether they need to look jacked',
  },
  {
    href: '/posts/follow-up-for-trainers',
    title: 'How to Follow Up With Personal Training Leads',
    description: 'A simple three-part system for following up without sounding pushy.',
    category: 'Sales',
    image: '/posts/follow-up-for-trainers/images/personal-training-client-follow-up-system.png',
    imageAlt: 'Personal training client follow up system',
  },
  {
    href: '/posts/a-non-trendy-take-on-where-fitness-is-going',
    title: 'Where Fitness Is Really Heading in 2026',
    description: 'A grounded look at retention, applied health, social-first fitness and operational AI.',
    category: 'Fitness Industry',
    image: '/posts/a-non-trendy-take-on-where-fitness-is-going/images/fitness-trends-2026.jpeg',
    imageAlt: 'fitness trends 2026',
  },
];

const tools = [
  {
    href: '/tools/wearable-tracking-for-coaches/biweekly-wearable-check-in-for-coaches/',
    number: '01',
    title: 'Wearable Data Interpretation Tool',
    description: 'Turn HRV, resting heart rate, sleep and training-load changes into a clearer coaching conversation.',
    action: 'Run the check-in',
  },
  {
    href: '/tools/wearable-tracking-for-coaches/vo2max-training-protocol/',
    number: '02',
    title: 'VO₂ Max Training Protocol Finder',
    description: 'Match a client’s recent readings, recovery and current training week with a suitable interval protocol.',
    action: 'Find a protocol',
  },
  {
    href: '/tools/find-your-ideal-clients-faqs-for-coaches/',
    number: '03',
    title: 'Ideal Client FAQ Finder',
    description: 'Build an ideal-client profile and turn real audience questions into useful content topics.',
    action: 'Find client FAQs',
  },
];

const description = 'Practical fitness marketing tools, articles and systems for personal trainers, coaches and independent fitness businesses.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://fitnessxmarketing.com/#website',
      url: 'https://fitnessxmarketing.com/',
      name: 'Fitness x Marketing',
      description,
      publisher: { '@id': 'https://fitnessxmarketing.com/#organization' },
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': 'https://fitnessxmarketing.com/#organization',
      name: 'Fitness x Marketing',
      url: 'https://fitnessxmarketing.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://fitnessxmarketing.com/fitness-x-marketing-logo.jpeg',
      },
      sameAs: [
        'https://www.instagram.com/fitnessxmarketing/',
        'https://www.linkedin.com/company/fitness-x-marketing/',
      ],
    },
  ],
};
---

<Layout
  title="Fitness Marketing Tools and Articles for Personal Trainers"
  description={description}
  canonical="/"
  mainClass="landing-main"
  structuredData={structuredData}
>
  <div class="home-page">
    <section class="hero shell">
      <p class="eyebrow">Independent resource hub</p>
      <h1>Practical systems for growing a fitness business.</h1>
      <p class="hero-copy">Marketing, sales, AI and coaching resources for personal trainers, coaches and independent fitness businesses.</p>
      <div class="decisions" aria-label="Choose where to start">
        <a href="/posts">
          <span>Read & learn</span>
          <small>Articles and practical frameworks</small>
          <strong aria-hidden="true">→</strong>
        </a>
        <a class="featured" href="/tools">
          <span>Use free tools</span>
          <small>Interactive tools built for coaches</small>
          <strong aria-hidden="true">→</strong>
        </a>
        <a href="/newsletter/">
          <span>Join the newsletter</span>
          <small>One useful thing at a time</small>
          <strong aria-hidden="true">→</strong>
        </a>
      </div>
    </section>

    <section class="content-section shell" aria-labelledby="latest-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest articles</p>
          <h2 id="latest-heading">Ideas you can put to work.</h2>
        </div>
        <a href="/posts">View all articles →</a>
      </div>

      <div class="card-scroller article-scroller">
        {posts.map((post) => (
          <article class="article-card">
            <a class="card-image" href={post.href} aria-label={post.title}>
              <img src={post.image} alt={post.imageAlt} width="1200" height="630" loading="lazy" decoding="async" />
            </a>
            <div class="card-copy">
              <p class="category">{post.category}</p>
              <h3><a href={post.href}>{post.title}</a></h3>
              <p>{post.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section tools-section" aria-labelledby="tools-heading">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Free tools</p>
            <h2 id="tools-heading">Make the next decision clearer.</h2>
          </div>
          <a href="/tools">View all tools →</a>
        </div>

        <div class="card-scroller tool-scroller">
          {tools.map((tool) => (
            <article class="tool-card">
              <p class="tool-number">{tool.number}</p>
              <h3><a href={tool.href}>{tool.title}</a></h3>
              <p>{tool.description}</p>
              <a class="text-link" href={tool.href}>{tool.action} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="newsletter-band">
      <div class="shell newsletter-grid">
        <div>
          <p class="eyebrow">The newsletter</p>
          <h2>One useful thing at a time.</h2>
        </div>
        <div>
          <p>New tools, frameworks, research and practical ideas—sent when there is something worth sharing.</p>
          <a class="button" href="/newsletter/">See what you’ll get →</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .home-page { overflow: hidden; }
    .shell { margin: 0 auto; max-width: 1180px; padding-left: clamp(1.25rem, 4vw, 3rem); padding-right: clamp(1.25rem, 4vw, 3rem); }
    .hero { padding-bottom: clamp(4rem, 8vw, 7rem); padding-top: clamp(4rem, 9vw, 7.5rem); }

    .eyebrow, .category, .tool-number {
      color: #068f8c;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(3rem, 7.7vw, 6.2rem);
      letter-spacing: -0.065em;
      line-height: 0.98;
      margin: 1rem 0 1.5rem;
      max-width: 11ch;
    }

    .hero-copy {
      color: #3a4252;
      font-size: clamp(1.15rem, 2.4vw, 1.45rem);
      line-height: 1.55;
      max-width: 64ch;
    }

    .decisions { display: grid; gap: 0.85rem; grid-template-columns: repeat(3, 1fr); margin-top: 3rem; }
    .decisions a {
      align-items: center;
      background: #fff;
      border: 1px solid #cfd6da;
      border-radius: 14px;
      color: #252a34;
      display: grid;
      gap: 0.2rem 1rem;
      grid-template-columns: 1fr auto;
      min-height: 122px;
      padding: 1.3rem;
      text-decoration: none;
      transition: border-color 160ms ease, transform 160ms ease;
    }
    .decisions a:hover { border-color: #068f8c; transform: translateY(-2px); }
    .decisions .featured { background: #252a34; border-color: #252a34; color: #fff; }
    .decisions span { font-size: 1.05rem; font-weight: 800; }
    .decisions small { color: #687281; font-size: 0.83rem; grid-column: 1; }
    .decisions .featured small { color: #cfd9dd; }
    .decisions strong { color: #08d9d6; font-size: 1.35rem; grid-column: 2; grid-row: 1 / span 2; }

    .content-section {
      border-top: 1px solid #dfe3e6;
      padding-bottom: clamp(4rem, 8vw, 7rem);
      padding-top: clamp(4rem, 8vw, 6rem);
    }
    .tools-section { background: #f5fbfb; max-width: none; }
    .section-heading { align-items: flex-end; display: flex; gap: 2rem; justify-content: space-between; margin-bottom: 2rem; }
    .section-heading h2, .newsletter-band h2 {
      font-size: clamp(2rem, 5vw, 3.35rem);
      letter-spacing: -0.045em;
      line-height: 1.05;
      margin: 0.6rem 0 0;
    }
    .section-heading > a {
      color: #252a34;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-decoration-color: #08d9d6;
      text-underline-offset: 0.3rem;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .card-scroller {
      display: grid;
      gap: 1.15rem;
      grid-auto-columns: minmax(285px, 32%);
      grid-auto-flow: column;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      padding: 0.25rem 0 1rem;
      scroll-snap-type: inline mandatory;
      scrollbar-color: #9fb4b8 transparent;
    }
    .article-card, .tool-card { background: #fff; border: 1px solid #d7dde0; border-radius: 14px; overflow: hidden; scroll-snap-align: start; }
    .card-image { display: block; }
    .card-image img { aspect-ratio: 1200 / 630; display: block; height: auto; object-fit: cover; width: 100%; }
    .card-copy, .tool-card { padding: 1.25rem; }
    .card-copy h3, .tool-card h3 { font-size: 1.25rem; letter-spacing: -0.025em; line-height: 1.25; margin: 0.55rem 0 0.75rem; }
    .card-copy h3 a, .tool-card h3 a { color: #252a34; text-decoration: none; }
    .card-copy > p:last-child, .tool-card > p:not(.tool-number) { color: #596371; font-size: 0.92rem; line-height: 1.55; }
    .tool-card { display: flex; flex-direction: column; min-height: 290px; }
    .tool-number { margin: 0; }
    .text-link { color: #068f8c; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; margin-top: auto; text-decoration: none; text-transform: uppercase; }

    .newsletter-band { background: #252a34; color: #fff; padding: clamp(4rem, 8vw, 7rem) 0; }
    .newsletter-grid { align-items: center; display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; }
    .newsletter-band .eyebrow { color: #08d9d6; }
    .newsletter-band p { color: #dbe2e5; font-size: 1.05rem; max-width: 52ch; }
    .button { background: #08d9d6; color: #252a34; display: inline-block; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; margin-top: 1rem; padding: 0.9rem 1.1rem; text-decoration: none; text-transform: uppercase; }

    @media (max-width: 760px) {
      .decisions, .newsletter-grid { grid-template-columns: 1fr; }
      .decisions a { min-height: 104px; }
      .section-heading { align-items: flex-start; flex-direction: column; }
      .card-scroller { grid-auto-columns: minmax(270px, 84%); }
    }
  </style>
</Layout>
