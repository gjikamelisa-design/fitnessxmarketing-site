---
import FunnelLanding from '../components/FunnelLanding';
import '../styles/funnel.css';
import '../styles/funnel-enhancements.css';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Claude Workspace Sprint for Fitness Businesses | Fitness x Marketing</title>
    <meta name="description" content="Tried Claude. Still doing all the work? One Claude workspace and three custom workflows for your fitness business. Start with a free 30-minute strategy call." />
    <link rel="canonical" href="https://fitnessxmarketing.com/" />
    <meta property="og:title" content="Tried Claude. Still doing all the work?" />
    <meta property="og:description" content="One workspace. Three workflows. Start with a free 30-minute strategy call." />
    <meta property="og:url" content="https://fitnessxmarketing.com/" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#eaf6f6" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.dataset.view = location.hash === '#book' ? 'book' : 'landing';</script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){window.dataLayer.push(arguments)};
      gtag('js', new Date());
      gtag('config', 'G-ZHVLV2DEVT');
      window.trackEvent = window.trackEvent || function(name, properties){gtag('event', name, properties)};
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZHVLV2DEVT"></script>
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <div id="landing-view"><FunnelLanding /></div>
    <div id="booking-view"><div id="book">
      <header class="booking-header">
        <a class="font-display text-xl font-extrabold tracking-[-0.05em]" href="#top" aria-label="FxM. Home">FxM<span class="text-brand-deep">.</span></a>
      </header>
      <main id="booking-main" class="booking-main">
        <div class="booking-intro">
          <h1 tabindex="-1" id="booking-title">Your free strategy call</h1>
          <p>30 minutes. No obligation. Bring one recurring task and an example of how you handle it today.</p>
          <p class="booking-note">The call is free. The $297 Claude Workspace Sprint is optional.</p>
        </div>
        <section id="booking-confirmation" class="booking-confirmation" role="status" aria-live="polite" hidden>
          <h2 tabindex="-1">Your strategy call is booked.</h2>
          <p>Bring one recurring task and an example of how you handle it today.</p>
        </section>
        <div id="scheduler" class="scheduler" aria-label="Book your free strategy call">
          <p id="scheduler-loading" role="status">Loading available times…</p>
        </div>
        <p class="booking-fallback">Prefer a direct link or having trouble loading? <a id="calendly-fallback" href="https://calendly.com/gjikamelisa/discovery/">Book directly on Calendly</a></p>
        <noscript><p>Use the Calendly link above to choose your time.</p></noscript>
      </main>
      <footer class="booking-footer">Independent consultancy. Not affiliated with or endorsed by Anthropic or Upwork. <a href="/privacy-policy/">Privacy</a></footer>
    </div></div>
    <script src="../scripts/booking.ts"></script>
  </body>
</html>
