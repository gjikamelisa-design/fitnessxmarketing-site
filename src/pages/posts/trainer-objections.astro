    }

    .eyebrow,
    .kicker {
      color: #068f8c;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .eyebrow a { color: inherit; text-decoration: none; }

    h1 {
      font-size: clamp(2.35rem, 6.8vw, 4.65rem);
      letter-spacing: -0.045em;
      line-height: 1.02;
      margin: 0.8rem 0 1.3rem;
      max-width: 19ch;
    }

    .dek {
      color: #3a4252;
      font-size: clamp(1.15rem, 2.5vw, 1.4rem);
      line-height: 1.55;
      max-width: 62ch;
    }

    .byline {
      align-items: center;
      color: #606a78;
      display: flex;
      flex-wrap: wrap;
      font-size: 0.9rem;
      gap: 0.45rem;
      margin-top: 1.7rem;
    }

    .byline span:first-child { color: #252a34; font-weight: 700; }

    .article-body {
      font-size: 1.06rem;
      margin: 0 auto;
      max-width: var(--article-width);
    }

    .lead {
      color: #252a34;
      font-size: 1.3rem;
      font-weight: 560;
      line-height: 1.55;
    }

    h2 {
      font-size: clamp(1.9rem, 5vw, 2.75rem);
      letter-spacing: -0.035em;
      line-height: 1.18;
      margin: 4.8rem 0 1.35rem;
      scroll-margin-top: 2rem;
    }

    p,
    li { color: #3a4252; }
    li + li { margin-top: 0.55rem; }
    strong { color: #252a34; }
    a { font-weight: 650; text-underline-offset: 0.2rem; }

    figure { margin: 2.5rem 0; }
    figure img {
      border: 1px solid #dfe3e6;
      border-radius: 12px;
      display: block;
      height: auto;
      max-width: 100%;
      width: 100%;
    }

