      letter-spacing: 0.12em;
      margin: 0 0 0.7rem;
      text-transform: uppercase;
    }

    .contents ol { margin: 0; padding-left: 1.25rem; }
    .contents a { color: #252a34; text-decoration-color: #08d9d6; }

    blockquote {
      border-left: 4px solid #08d9d6;
      margin: 2rem 0;
      padding: 0.3rem 0 0.3rem 1.4rem;
    }

    blockquote p {
      color: #252a34;
