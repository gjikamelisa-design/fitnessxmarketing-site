];

const related = [
  {
    href: '/posts/personal-trainer-claude-setup/',
    kicker: 'Case study',
    title: "10 Hours a Week Back: A Client's AI Workspace Cleanup",
    description: 'How one trainer went from 14 Claude projects to 10 and got 10+ hours back every week.',
    image: '/posts/personal-trainer-claude-setup/images/weekly-plan-hub.png',
    imageAlt: 'A weekly plan for a personal trainer with the top 3 priorities and tasks tagged by area',
    width: 1400,
    height: 830,
  },
  {
    href: '/posts/ai-in-fitness-industry/',
    kicker: 'Fitness industry',
    title: 'Fitness AI in 2026: What’s Built, Funded and Used',
    description: 'Where the money goes in fitness AI, what gyms actually use, and who owns the data.',
    image: '/posts/ai-in-fitness-industry/images/four-jobs-of-fitness-ai.png',
    imageAlt: 'The four kinds of fitness AI: sensing, predictive, generative and automation, with example companies under each',
