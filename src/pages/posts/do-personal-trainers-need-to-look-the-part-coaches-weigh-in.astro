      font-size: 0.9rem;
      gap: 0.45rem;
      margin-top: 1.7rem;
    }

    .byline span:first-child {
      color: #252a34;
      font-weight: 700;
    }

    .article-body {
      font-size: 1.06rem;
      margin: 0 auto;
      max-width: var(--article-width);
    }

    .lead {
      color: #252a34;
      font-size: 1.3rem;
      font-weight: 560;
      line-height: 1.55;
    }

    h2 {
      font-size: clamp(1.9rem, 5vw, 2.75rem);
      letter-spacing: -0.035em;
      line-height: 1.18;
      margin: 4.8rem 0 1.35rem;
      scroll-margin-top: 2rem;
    }

    p,
    li {
      color: #3a4252;
    }

    li + li {
      margin-top: 0.55rem;
    }

    strong {
      color: #252a34;
    }

    a {
      font-weight: 650;
      text-underline-offset: 0.2rem;
    }

    figure {
      margin: 2.5rem 0;
    }

    figure img {
      border: 1px solid #dfe3e6;
      border-radius: 12px;
      display: block;
      height: auto;
      max-width: 100%;
      width: 100%;
    }

    figcaption {
      color: #687281;
      font-size: 0.88rem;
      margin-top: 0.75rem;
      text-align: center;
    }

    .wide-figure {
      margin-left: calc((min(900px, 100vw - 3rem) - min(70ch, 100vw - 3rem)) / -2);
      margin-right: calc((min(900px, 100vw - 3rem) - min(70ch, 100vw - 3rem)) / -2);
    }

    .contents {
      background: #f5fbfb;
      border: 1px solid #d3eeee;
