      font-size: 1.05rem;
      font-weight: 560;
      margin: 0;
    }

    .centered-action {
      margin: 2rem 0;
      text-align: center;
    }

    .button {
      background: #252a34;
      border: 1px solid #252a34;
      color: #fff;
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 800;
