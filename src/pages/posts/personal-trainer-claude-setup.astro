    tbody td { color: #3a4252; }
    tbody td:last-child { background: #f5fbfb; color: #252a34; font-weight: 650; }

    .z-list {
      margin: 2.5rem calc((min(900px, 100vw - 3rem) - min(70ch, 100vw - 3rem)) / -2);
    }
    .z-row {
      align-items: center;
      border-top: 1px solid #dfe3e6;
