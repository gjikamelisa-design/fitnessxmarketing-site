        width: 100%;
      }
    }
    .table-wrap { overflow-x: auto; margin: 2rem 0; border: 1px solid #dfe3e6; border-radius: 14px; }
    table { border-collapse: collapse; width: 100%; font-size: 0.98rem; }
    thead th { background: #252a34; color: #fff; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-align: left; text-transform: uppercase; padding: 0.9rem 1.1rem; }
