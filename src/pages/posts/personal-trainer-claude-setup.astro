    .stat span { color: #c9d1d6; display: block; font-size: 0.95rem; font-weight: 600; margin-top: 0.6rem; }
    @media (max-width: 640px) { .stats { grid-template-columns: 1fr; } }
    .faq-list { border-top: 1px solid #dfe3e6; margin-top: 1.5rem; }
    .faq { border-bottom: 1px solid #dfe3e6; padding: 1.4rem 0; }
    .faq h3 { font-size: 1.15rem; margin: 0 0 0.5rem; }
    .faq p { margin: 0; }
  </style>
</Layout>
