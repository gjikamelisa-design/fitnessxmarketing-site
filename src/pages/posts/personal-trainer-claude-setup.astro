---
import Layout from '../../layouts/Layout.astro';

const title = "10 Hours a Week Back: A Client's AI Workspace Cleanup and What Personal Trainers Can Learn";
const metaTitle = 'How Personal Trainers Can Clean Up Their AI Setup: A Case Study';
const description = "Personal trainer using AI for clients, content and admin? A client had one task in five places. Fixing that saved 10 hours a week over 7 weeks.";
const canonical = '/posts/personal-trainer-claude-setup/';
const pageUrl = `https://fitnessxmarketing.com${canonical}`;
const articleId = `${pageUrl}#article`;
const publishedTime = '2026-11-25T12:00:00.000Z';
const heroImage = 'https://fitnessxmarketing.com/posts/personal-trainer-claude-setup/images/weekly-plan-hub.png';


const faqs = [
  {
    q: 'How can personal trainers use Claude?',
    a: 'Personal trainers use Claude to draft posts and captions, reply to new leads, write client check-ins and program notes, and plan their week. It works best when each job has its own Claude project with your instructions and files saved inside. That way you don\'t explain your business from scratch every time. Our guide to <a href="/posts/ai-for-personal-trainers-top-uses-cases-tasks/">AI for personal trainers</a> lists the top use cases.',
  },
  {
    q: 'What can fitness businesses do with AI tools?',
    a: 'Fitness businesses use AI tools for four kinds of work: content (posts, emails, blogs), communication (sorting inquiries and drafting replies), research (industry questions, with sources) and planning (turning tasks into a weekly plan). Tools like Claude, Canva and Exa can be connected so one AI agent handles a full job. Reading the results, making the calls and owning client relationships should stay with you.',
  },
  {
    q: 'What is FxM?',
    a: 'FxM (Fitness x Marketing) sets up AI operations for small and mid-size fitness businesses. We audit how your workday actually runs, then build AI agents around it. Our approach: fix the setup, not the prompt.',
  },
  {
    q: 'How can FxM help me?',
    a: 'FxM starts with a free discovery call and an audit of your workday, to find where you are falling behind. From there, you get a plan and up to three custom AI agents built around how you actually work, in areas like content, lead replies, research or weekly planning. <a href="/claude-for-fitness-businesses/">See how it works</a>.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': articleId,
      headline: title,
      name: metaTitle,
      description,
      abstract:
        "A personal trainer's Claude setup went from 14 overlapping projects to 10, each with one clear job, plus three AI agents and one short CLAUDE.md guide. Time saved: 10+ hours a week, measured over 7 weeks.",
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      inLanguage: 'en',
      datePublished: publishedTime,
      dateModified: publishedTime,
      articleSection: 'Case Studies',
      genre: 'Case study',
      image: {
        '@type': 'ImageObject',
        url: heroImage,
        width: 1400,
        height: 830,
        caption: 'A weekly plan for a personal trainer with the top 3 priorities and tasks tagged by area',
      },
      author: [
        {
          '@type': 'Person',
          name: 'Melisa Gjika',
          jobTitle: 'AI operations for fitness businesses',
          worksFor: { '@id': 'https://fitnessxmarketing.com/#organization' },
        },
        { '@id': 'https://fitnessxmarketing.com/#organization' },
      ],
      publisher: {
        '@type': 'Organization',
        '@id': 'https://fitnessxmarketing.com/#organization',
        name: 'Fitness x Marketing',
        url: 'https://fitnessxmarketing.com/',
        logo: {
          '@type': 'ImageObject',
          url: 'https://fitnessxmarketing.com/fitness-x-marketing-logo.jpeg',
        },
      },
      isPartOf: { '@id': 'https://fitnessxmarketing.com/#website' },
      audience: { '@type': 'Audience', audienceType: 'Personal trainers and fitness business owners' },
      about: [
        { '@type': 'Thing', name: 'Claude Projects setup for personal trainers' },
        { '@type': 'Thing', name: 'AI workspace organization' },
        { '@type': 'Thing', name: 'AI agents for fitness businesses' },
        { '@type': 'Thing', name: 'CLAUDE.md' },
      ],
      mentions: [
        { '@type': 'SoftwareApplication', name: 'Claude', applicationCategory: 'AI assistant', publisher: { '@type': 'Organization', name: 'Anthropic' } },
        { '@type': 'SoftwareApplication', name: 'Exa', applicationCategory: 'AI search' },
        { '@type': 'SoftwareApplication', name: 'Canva', applicationCategory: 'Design' },
        { '@type': 'SoftwareApplication', name: 'Instagram', applicationCategory: 'Social media' },
        { '@type': 'SoftwareApplication', name: 'Telegram', applicationCategory: 'Messaging' },
      ],
      keywords: [
        'Claude projects',
        'AI workspace',
        'AI for personal trainers',
        'CLAUDE.md',
        'AI agents',
        'AI setup case study',
        'fitness business AI',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fitnessxmarketing.com/' },
        { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://fitnessxmarketing.com/posts/' },
        { '@type': 'ListItem', position: 3, name: metaTitle, item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={metaTitle}
  titleTemplate={false}
  description={description}
  canonical={canonical}
  type="article"
  image={heroImage}
  imageAlt="A weekly plan for a personal trainer with the top 3 priorities and tasks tagged by area"
  structuredData={structuredData}
>
  <article>
    <header class="article-header">
      <p class="eyebrow"><a href="/posts/">Articles</a> / Case Study</p>
      <h1>{title}</h1>
    </header>

    <div class="article-body">
      <p class="lead">If you use Claude, the AI assistant, in your fitness business, the way you set it up decides how much time it saves you. We reorganized one personal trainer's Claude setup from 14 overlapping projects into 10, each with one clear job. <strong>The result: 10+ hours back every week, measured over 7 weeks.</strong></p>

      <p>Think of any Claude project as a labelled folder for one type of work, like your Instagram content or your client check-ins. You save the instructions and files once, and Claude uses them every time you start a chat there. In this trainer's case, a new project got added for every new need. That's how the setup reached 14, with the same instructions in several places and rules that contradicted each other. Together we decided on 10, each with one clear job.</p>

      <section id="before-after">
        <h2>Before and After</h2>
        <p>The client is a personal trainer with several offers: 1:1 clients in person, an online coaching program and small group classes. On top of training, they run a second business with its own clients and brand. Each offer has its own clients, prices and messages, and all of it ran through one Claude setup.</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col">What we changed</th><th scope="col">Before</th><th scope="col">After</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Projects</th><td>14, overlapping</td><td>10, clear jobs</td></tr>
              <tr><th scope="row">Instructions</th><td>Repeated, conflicting</td><td>Short shared guide</td></tr>
              <tr><th scope="row">Business details</th><td>Mixed across businesses</td><td>Separate per area</td></tr>
              <tr><th scope="row">Chats</th><td>Outside projects</td><td>Start in project</td></tr>
              <tr><th scope="row">Planning</th><td>Partial hub</td><td>One hub</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="review">
        <h2>How We Ran the Review</h2>
        <p>First we listed every project, chat, file, saved instruction, connected tool and recurring task.</p>
        <p>Then we gave each item one decision: turn it off, archive it, shorten it, fix it or leave it for later. We deliberately left five decisions or improvements for a later review.</p>
      </section>

      <section id="results">
        <h2>The Result: 10+ Hours Back Every Week</h2>
        <div class="stats">
          <div class="stat"><strong>10+</strong><span>hours back every week</span></div>
          <div class="stat"><strong>7</strong><span>weeks of measuring</span></div>
          <div class="stat"><strong>14<em>→</em>10</strong><span>projects, each with one job</span></div>
        </div>
        <p><strong>Change in the work:</strong> Less time spent on LLMs like Claude and more time on actual tasks, using AI to get things done rather than chat.</p>
      </section>


      <section id="changes">
        <h2>What We Changed</h2>
        <div class="z-list">
          <section class="z-row">
            <div class="z-text">
            <h3>Each project has one job</h3>
            <p>We gave the remaining 10 projects clear names and responsibilities. Four of them handle most of the day-to-day work.</p>
            <p>New work now starts inside the project it belongs to. Starting there keeps each chat next to the instructions and files it needs.</p>
            <p>The image shows how this AI workspace naming system looks for a personal trainer with three offers.</p>
            <p>Every Claude project name starts with its area, then its job: Brand, Strategy, Marketing, Sales, Delivery, Admin and one Hub for the weekly plan.</p>
            <p>Delivery is split by offer, so 1:1 clients, online coaching and small group each keep their own project instructions. The four marked Daily are the ones opened every day.</p>
            </div>
            <figure class="z-figure">
              <img src="/posts/personal-trainer-claude-setup/images/projects-one-job.png" alt="A list of 10 AI projects for a personal trainer, each named by area and job, such as Marketing: Instagram and Delivery: Online Coaching, with four marked as daily" width="880" height="1268" loading="lazy" decoding="async" />
              <figcaption>The same naming system for a personal trainer with several offers.</figcaption>
            </figure>
          </section>
          <section class="z-row z-flip">
            <div class="z-text">
            <h3>We created three AI agents</h3>
            <p>An AI agent is an assistant set up for one specific job, with its own tools and a clear limit on what it can do alone. We built three.</p>
            <p><strong>The research agent</strong> uses Claude with Exa to find and summarize fitness industry research. Every claim comes with its source link, so you can check it.</p>
            <p><strong>The Instagram agent</strong> uses Claude with Canva to draft captions and design posts in the trainer's brand. Nothing goes live on Instagram without the trainer's OK.</p>
            <p><strong>The Chief of Staff</strong> uses Claude with Telegram to run the daily plan. It only ever messages the trainer, never clients.</p>
            </div>
            <figure class="z-figure">
              <img src="/posts/personal-trainer-claude-setup/images/ai-agents.png" alt="Three AI agents with their tools and limits: a research agent using Claude and Exa, an Instagram agent using Claude, Canva and Instagram, and a Chief of Staff using Claude and Telegram" width="880" height="888" loading="lazy" decoding="async" />
              <figcaption>Each agent has one job, its own tools and a clear limit.</figcaption>
            </figure>
          </section>
          <section class="z-row z-wide">
            <div class="z-text">
            <h3>The Chief of Staff plans every day</h3>
            <p>The Chief of Staff runs on a schedule. Every morning it sends the trainer a short report on what needs doing that day, pulled from every area of the business.</p>
            <p>The trainer doesn't have to open a dashboard. They message the agent in plain words to add a task, mark one done or ask what's left, and it updates the plan for the rest of the day and week.</p>
            <p>The work itself still happens in the project responsible for it. The Chief of Staff just keeps track of it.</p>
            </div>
            <figure class="z-figure">
              <img class="z-big" src="/posts/personal-trainer-claude-setup/images/weekly-plan-hub.png" alt="A weekly plan for a personal trainer with the top 3 priorities and Monday to Friday tasks tagged by area: Marketing, Sales, Delivery, Admin and Hub" width="1400" height="830" loading="lazy" decoding="async" />
              <figcaption>One weekly plan for every area. The work itself stays in each project.</figcaption>
            </figure>
          </section>
          <section class="z-row z-flip">
            <div class="z-text">
            <h3>Shared rules fit in one short guide</h3>
            <p>I found that one task was described in five places, and three rules disagreed about where files should be saved.</p>
            <p>The fix was one short CLAUDE.md file. CLAUDE.md is a plain text file of house rules that Claude reads before it starts work. </p>
            <p>Think of it as the onboarding sheet you'd hand a new coach. Every project's instructions point back to it, so the basics are written once instead of five times.</p>
            <p>We cut it down to the rules every project needs: how the work is organized, how to name things and where to start. Detailed instructions moved into the project or agent that uses them.</p>
            </div>
            <figure class="z-figure">
              <img src="/posts/personal-trainer-claude-setup/images/shared-rules-tree.png" alt="A tree with CLAUDE.md at the top as the shared guide, and projects below it, each with its own instructions, context, memory or AI agent" width="880" height="1008" loading="lazy" decoding="async" />
              <figcaption>One shared guide on top, project-specific detail underneath.</figcaption>
            </figure>
          </section>
          <section class="z-row z-wide">
            <div class="z-text">
            <h3>Each business keeps its own details</h3>
            <p>The rules for one business were also being applied to the other. We separated the business details and gave each project its own responsibilities. Now each job uses the right information.</p>
            </div>
            <figure class="z-figure">
              <img class="z-gif" src="/posts/personal-trainer-claude-setup/images/inside-one-project.gif" alt="Clicking into one project in Claude and opening its Instructions, Context and Memory panels, with names and content blurred" width="720" height="450" loading="lazy" decoding="async" />
              <figcaption>Inside one of the owner's projects. Names and content are blurred.</figcaption>
            </figure>
          </section>
        </div>
      </section>


      <section id="faq">
        <h2>FAQs</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq">
              <h3>{f.q}</h3>
              <p set:html={f.a} />
            </div>
          ))}
        </div>
      </section>

      <section id="your-setup">
        <h2>Get Your AI in Order!</h2>
        <p>If you are still deciding which tasks to give AI, our guide to <a href="/posts/ai-for-personal-trainers-top-uses-cases-tasks/">AI for personal trainers</a> walks through the top use cases and tasks.</p>

        <aside class="final-cta">
          <p class="kicker">FxM workday audit</p>
          <h2>Want help organizing your own AI setup?</h2>
          <p>Start with an FxM workday audit: a review of your daily work and where AI could help.</p>
          <a class="button button-light" href="/claude-for-fitness-businesses/">See how the audit works</a>
        </aside>
      </section>
    </div>
  </article>

  <style>
    article {
      --article-width: 70ch;
    }

    .article-header {
      border-bottom: 1px solid #dfe3e6;
      margin-bottom: 2.5rem;
      padding: 1.5rem 0 2.5rem;
    }

    .eyebrow,
    .kicker {
      color: #068f8c;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .eyebrow a {
      color: inherit;
      text-decoration: none;
    }

    h1 {
      font-size: clamp(2.35rem, 6.8vw, 4.65rem);
      letter-spacing: -0.045em;
      line-height: 1.02;
      margin: 0.8rem 0 1.3rem;
      max-width: 18ch;
    }

    .dek {
      color: #3a4252;
      font-size: clamp(1.15rem, 2.5vw, 1.4rem);
      line-height: 1.55;
      max-width: 62ch;
    }

    .byline {
      align-items: center;
      color: #606a78;
      display: flex;
      flex-wrap: wrap;
      font-size: 0.9rem;
      gap: 0.45rem;
      margin-top: 1.7rem;
    }

    .byline span:first-child {
      color: #252a34;
      font-weight: 700;
    }

    .article-body {
      font-size: 1.06rem;
      margin: 0 auto;
      max-width: var(--article-width);
    }

    .lead {
      color: #252a34;
      font-size: 1.3rem;
      font-weight: 560;
      line-height: 1.55;
    }

    h2,
    h3 {
      line-height: 1.18;
      scroll-margin-top: 2rem;
    }

    h2 {
      font-size: clamp(1.9rem, 5vw, 2.75rem);
      letter-spacing: -0.035em;
      margin: 4.8rem 0 1.35rem;
    }

    h3 {
      font-size: clamp(1.3rem, 3.5vw, 1.65rem);
      letter-spacing: -0.015em;
      margin: 0 0 0.8rem;
    }

    p,
    li {
      color: #3a4252;
    }

    li + li {
      margin-top: 0.55rem;
    }

    strong {
      color: #252a34;
    }

    a {
      font-weight: 650;
      text-underline-offset: 0.2rem;
    }

    figure {
      margin: 2.5rem 0;
    }

    figure img {
      border-radius: 12px;
      display: block;
      height: auto;
      max-width: 100%;
      width: 100%;
    }

    figcaption {
      color: #687281;
      font-size: 0.88rem;
      margin-top: 0.75rem;
      text-align: center;
    }

    .hero-figure {
      margin-top: 0;
    }

    .wide-figure {
      margin-left: calc((min(900px, 100vw - 3rem) - min(70ch, 100vw - 3rem)) / -2);
      margin-right: calc((min(900px, 100vw - 3rem) - min(70ch, 100vw - 3rem)) / -2);
    }

    .portrait-figure {
      margin-left: auto;
      margin-right: auto;
      max-width: 580px;
    }

    .contents {
      background: #f5fbfb;
      border: 1px solid #d3eeee;
      border-radius: 14px;
      margin: 2.8rem 0;
      padding: 1.35rem 1.5rem;
    }

    .contents > p {
      color: #252a34;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      margin: 0 0 0.7rem;
      text-transform: uppercase;
    }

    .contents ol {
      margin: 0;
      padding-left: 1.25rem;
    }

    .contents a {
      color: #252a34;
      text-decoration-color: #08d9d6;
    }

    .steps {
      border-bottom: 1px solid #dfe3e6;
      margin: 2.5rem 0;
    }

    .steps > section {
      border-top: 1px solid #dfe3e6;
      padding: 1.75rem 0;
    }

