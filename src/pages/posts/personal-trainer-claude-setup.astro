      font-size: 0.85rem;
      font-weight: 700;
      justify-content: center;
      padding: 1rem;
      text-align: center;
    }
    @media (max-width: 720px) {
      .z-list { margin-left: 0; margin-right: 0; }
      .z-row { grid-template-columns: 1fr; }
      .z-flip .z-figure { order: 0; }
      .z-wide, .z-flip.z-wide { grid-template-columns: 1fr; }
    }
    .stats { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 1.75rem 0 1.5rem; }
    .stat { background: #252a34; border-radius: 16px; color: #fff; padding: 1.4rem 1.25rem; }
    .stat strong { color: #08d9d6; display: block; font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
