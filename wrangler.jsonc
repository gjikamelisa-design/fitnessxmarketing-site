{
  "name": "fitnessxmarketing-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "routes": [
    {
      "pattern": "fitnessxmarketing.com/*",
      "zone_name": "fitnessxmarketing.com"
    }
  ],
  "vars": {
    "PROFOUND_API_URL": "https://artemis.api.tryprofound.com/v1/logs/cloudflare_worker"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
